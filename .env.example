# Setup script configuration
REPO_NAME=fuze-store-cloud-server
DOMAIN=socket.dev.fuze-store.com
CERTBOT_EMAIL=admin@socket.dev.fuze-store.com
SOKETI_USER=ubuntu
INSTALL_DIR=/home/ubuntu/fuze-store-cloud-server

# Soketi environment configuration

SOKETI_DEBUG=false
# App manager driver. "array" (RECOMMENDED, what EC2 runs): serves the single
# app from SOKETI_DEFAULT_APP_* below — no database dependency.
# "postgres" requires the websocket_apps table to EXIST and hold an app row
# (run setup.sql against the target DB + INSERT the app) — with the table
# missing, soketi crash-loops on the first client connect (unhandledRejection,
# nginx 502s; incident 2026-07-16). Do not ship "postgres" half-provisioned.
SOKETI_APP_MANAGER_DRIVER=array

# PostgreSQL connection
SOKETI_DB_POSTGRES_HOST=db
SOKETI_DB_POSTGRES_PORT=5432
SOKETI_DB_POSTGRES_USERNAME=soketi
SOKETI_DB_POSTGRES_PASSWORD=soketi_secret
SOKETI_DB_POSTGRES_DATABASE=soketi
SOKETI_APP_MANAGER_POSTGRES_TABLE=websocket_apps
SOKETI_APP_MANAGER_POSTGRES_VERSION=13.3

# App Manager Cache (per-app, in-memory)
SOKETI_APP_MANAGER_CACHE_ENABLED=true
SOKETI_APP_MANAGER_CACHE_TTL=-1

# Rate limiter
SOKETI_RATE_LIMITER_DRIVER=local

# Limits
SOKETI_HTTP_MAX_REQUEST_SIZE=100
SOKETI_EVENT_MAX_CHANNELS_AT_ONCE=100
SOKETI_EVENT_MAX_NAME_LENGTH=200
SOKETI_EVENT_MAX_SIZE_IN_KB=100
SOKETI_EVENT_MAX_BATCH_SIZE=10
SOKETI_CHANNEL_MAX_NAME_LENGTH=100
SOKETI_PRESENCE_MAX_MEMBER_SIZE=10
SOKETI_PRESENCE_MAX_MEMBERS=100

# Webhooks
SOKETI_WEBHOOKS_BATCHING=1
SOKETI_WEBHOOKS_BATCHING_DURATION=1000

# Default APP
SOKETI_DEFAULT_APP_ID=fuze-store-app-id
SOKETI_DEFAULT_APP_KEY=fuze-store-app-key
SOKETI_DEFAULT_APP_SECRET=fuze-store-app-secret
SOKETI_APP_KEY=fuze-store-app-key
SOKETI_APP_ID=fuze-store-app-id
SOKETI_APP_SECRET=fuze-store-app-secret

# Server
SOKETI_HOST=0.0.0.0
SOKETI_PORT=6001
SOKETI_SHUTDOWN_GRACE_PERIOD=10000

# Capacity (seeded into the websocket_apps row by setup.sh).
# -1 = unlimited (bounded only by the box's RAM + file descriptors). Do NOT set a low
# fixed cap — scale by resizing the instance instead.
SOKETI_APP_MAX_CONNECTIONS=-1
SOKETI_APP_MAX_BACKEND_EVENTS_PER_SEC=-1
SOKETI_APP_MAX_CLIENT_EVENTS_PER_SEC=-1
SOKETI_APP_MAX_READ_REQ_PER_SEC=-1

# Log retention (days) for journald + nginx logrotate configured by setup.sh
LOG_RETENTION_DAYS=14
